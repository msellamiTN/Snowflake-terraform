# Copy to terraform.tfvars and fill in your Snowflake identifiers.
# The PAT is read automatically from secrets/snowflake_pat.txt — do NOT put it here.

snowflake_organization = "<snowflake-organization>"
snowflake_account      = "<snowflake-account>"
snowflake_user         = "DATA2AI"
snowflake_role         = "ACCOUNTADMIN"
# snowflake_token is read from secrets/snowflake_pat.txt automatically
# Do not set it here.
environment            = "DEV"
warehouse_size         = "X-SMALL"
