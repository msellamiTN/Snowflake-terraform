# Copy this file to terraform.tfvars and replace the non-secret Snowflake identifiers.
# Supply the PAT only through TF_VAR_snowflake_token; never write it in this file.

snowflake_organization = "<snowflake-organization>"
snowflake_account      = "<snowflake-account>"
snowflake_user         = "<snowflake-user>"
learner_prefix         = "APP01"
environment            = "DEV"
warehouse_size         = "X-SMALL"
