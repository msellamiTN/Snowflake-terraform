# Copy this file to .env. Never commit .env or secret values.
# Values below are identifiers and local paths, not credentials.

TRAINING_ACCESS_SCENARIO=SANDBOX
TEMPLATE_REPO_URL=https://github.com/msellamiTN/data-platform-starter.git
SNOWFLAKE_ORGANIZATION=<organization>
SNOWFLAKE_ACCOUNT=<account>
SNOWFLAKE_ADMIN_USER=<admin-user>
SNOWFLAKE_TERRAFORM_USER=TERRAFORM_SVC
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_ADMIN_CONNECTION=admin
SNOWFLAKE_TERRAFORM_CONNECTION=terraform_svc
SNOWFLAKE_AUTH_MODE=PAT
SNOWFLAKE_ADMIN_PAT_FILE=secrets/snowflake_admin_pat.txt
SNOWFLAKE_TERRAFORM_PAT_FILE=secrets/snowflake_terraform_pat.txt
SNOWFLAKE_PRIVATE_KEY_FILE=secrets/snowflake_key.p8
TRAINING_NETWORK_ALLOWED_IPS=<your-public-ip>/32
ENVIRONMENT=DEV
TEAM=DATA_ENG
