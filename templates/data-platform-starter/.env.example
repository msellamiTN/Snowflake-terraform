# Copy this file to .env. Never commit .env or secret values.
# Values below are identifiers and local paths, not credentials.
#
# The .env file is gitignored. It is loaded by local scripts only.
# Never put a PAT, password or private key in this file.

# Project type template URL (provided by the instructor)
TEMPLATE_REPO_URL=https://github.com/<your-organisation>/data-platform-starter.git

# Snowflake identifiers (not secrets)
SNOWFLAKE_ORGANIZATION=<organization>
SNOWFLAKE_ACCOUNT=<account>
SNOWFLAKE_USER=<user>
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_CONNECTION=training

# Authentication mode: PAT for training, JWT for production target
SNOWFLAKE_AUTH_MODE=PAT

# PAT file path (the file is in secrets/ and is gitignored)
SNOWFLAKE_PAT_FILE=secrets/snowflake_pat.txt

# Private key file path (used from Day 4 onward, gitignored)
SNOWFLAKE_PRIVATE_KEY_FILE=secrets/snowflake_key.p8

# Learner prefix (3-5 uppercase letters, assigned by the instructor)
LEARNER_PREFIX=ABC

# Environment (DEV, UAT, PROD)
ENVIRONMENT=DEV

# Azure backend (filled in Day 2)
ARM_SUBSCRIPTION_ID=<subscription-id>
ARM_TENANT_ID=<tenant-id>
ARM_RESOURCE_GROUP=rg-data-platform-tfstate
ARM_STORAGE_ACCOUNT=stdataplatformtfstate
ARM_CONTAINER=tfstate
